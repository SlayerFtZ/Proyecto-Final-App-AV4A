<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppFinalAv4A.Features.auth.Presentation.screens.LoginScreen"
             Title="Iniciar sesión">

    <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

    
        <VerticalStackLayout Spacing="16" IsVisible="{Binding IsLoggedOut}">
            <Label Text="Bienvenido" FontSize="28" HorizontalOptions="Center" />

            <Button Text="Continuar con Google"
                    Command="{Binding SignInCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasError}" />
        </VerticalStackLayout>

    
        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsLoggedIn}">
            <Image Source="{Binding User.PictureUrl}"
                   HeightRequest="96" WidthRequest="96"
                   HorizontalOptions="Center" />
            <Label Text="{Binding User.Name}" FontSize="22" HorizontalOptions="Center" />
            <Label Text="{Binding User.Email}" HorizontalOptions="Center" />
            <Button Text="Cerrar sesión" Command="{Binding SignOutCommand}" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>