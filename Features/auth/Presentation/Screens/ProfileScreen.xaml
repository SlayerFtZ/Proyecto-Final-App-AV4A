<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:AppFinalAv4A.Features.auth.Presentation.screens"
             x:Class="AppFinalAv4A.Features.auth.Presentation.screens.ProfileScreen"
             x:DataType="vm:ProfileViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#DCEAFB">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#DCEAFB"
                                   StatusBarStyle="DarkContent"/>
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20,32,20,32"
                Spacing="18">

            <VerticalStackLayout Spacing="6"
                    HorizontalOptions="Center">
                <Border HeightRequest="120"
                        WidthRequest="120"
                        StrokeThickness="4"
                        Stroke="White"
                        StrokeShape="RoundRectangle 60"
                        HorizontalOptions="Center"
                        BackgroundColor="#B9D3F2">
                    <Border.Shadow>
                        <Shadow Brush="#0B2E57"
                                Opacity="0.20"
                                Radius="16"
                                Offset="0,6"/>
                    </Border.Shadow>
                    <Image Source="{Binding PictureUrl}"
                            Aspect="AspectFill"/>
                </Border>

                <Label Text="{Binding Name}"
                       Margin="0,10,0,0"
                       FontSize="24"
                        FontAttributes="Bold"
                       TextColor="#0F2A47"
                       HorizontalOptions="Center"/>
                <Label Text="{Binding Email}"
                       FontSize="14"
                       TextColor="#5B6B80"
                       HorizontalOptions="Center"/>

                <Button Text="✎  Editar perfil"
                        Margin="0,12,0,0"
                        BackgroundColor="#0A6CD1"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="44"
                        Padding="28,0"
                        HorizontalOptions="Center"/>
            </VerticalStackLayout>


            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    Padding="6,4">
                <VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                            Padding="14,16"
                            ColumnSpacing="12">
                        <Label Grid.Column="0"
                                FontSize="18"
                                VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                                Text="Notificaciones"
                                FontSize="15"
                                TextColor="#1F2D3D"
                                VerticalOptions="Center"/>


                    </Grid>
                    <BoxView HeightRequest="1"
                            Color="#EEF2F7"
                            Margin="14,0"/>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                            Padding="14,16"
                            ColumnSpacing="12">
                        <Label Grid.Column="0"
                                FontSize="18"
                                VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                                Text="Idioma"
                                FontSize="15"
                                TextColor="#1F2D3D"
                                VerticalOptions="Center"/>


                    </Grid>
                    <BoxView HeightRequest="1"
                            Color="#EEF2F7"
                            Margin="14,0"/>

                </VerticalStackLayout>
            </Border>
            <Button Text="Cerrar sesión"
                    Command="{Binding SignOutCommand}"
                    BackgroundColor="White"
                    TextColor="#D93025"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="52"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>